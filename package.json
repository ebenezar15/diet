{
  "name": "thalifit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:seed": "tsx scripts/validate-seed.ts",
    "build": "npm run validate:seed && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:artifact": "npm run validate:seed && VITE_TARGET=artifact vite build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.18.2",
    "html-to-image": "^1.11.13",
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  }
